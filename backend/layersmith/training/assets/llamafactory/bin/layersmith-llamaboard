#!/opt/venv/bin/python
"""Start LLaMA Board (LLaMA-Factory's web UI) with a login.

`llamafactory-cli webui` has no authentication of its own; this launcher
starts the same interface with Gradio's login. The password comes from, in
order: LLAMABOARD_PASSWORD, the file in LLAMABOARD_PASSWORD_FILE (default
/run/secrets/llamaboard_password), or a random one printed once at start.
The user name is LLAMABOARD_USER (default: trainer).

LLaMA Board works relative to its working directory: data/ (datasets with
dataset_info.json), saves/ (training results) and llamaboard_cache/. Missing
entries in /workspace are linked to /datasets, /outputs and /cache so results
land on the mounted host directories.
"""

import os
import secrets
import sys
from pathlib import Path

workspace = Path(os.environ.get("LLAMABOARD_WORKDIR", "/workspace"))
workspace.mkdir(parents=True, exist_ok=True)
os.chdir(workspace)
datasets = Path("/datasets")
links = {
    "data": datasets if (datasets / "dataset_info.json").is_file() else Path("/opt/layersmith/examples/llamafactory"),
    "saves": Path("/outputs"),
    "llamaboard_cache": Path(os.environ.get("XDG_CACHE_HOME", "/cache")) / "llamaboard",
}
for name, target in links.items():
    if not os.path.lexists(name):
        if name != "data":
            target.mkdir(parents=True, exist_ok=True)
        os.symlink(target, name)
    print(f"  {workspace / name} -> {os.path.realpath(name)}")

password = os.environ.get("LLAMABOARD_PASSWORD")
secret_file = Path(os.environ.get("LLAMABOARD_PASSWORD_FILE", "/run/secrets/llamaboard_password"))
if not password and secret_file.is_file():
    password = secret_file.read_text().strip()
if not password:
    password = secrets.token_urlsafe(18)
    print(f"\n  No LLAMABOARD_PASSWORD given; generated one for this run:\n    user: "
          f"{os.environ.get('LLAMABOARD_USER', 'trainer')}\n    password: {password}\n", flush=True)
user = os.environ.get("LLAMABOARD_USER", "trainer")

from llamafactory.webui.interface import create_ui  # noqa: E402  (after chdir: LLaMA Board reads cwd)

port = int(os.environ.get("GRADIO_SERVER_PORT", "7860"))
print(f"LLaMA Board on port {port}. Publish it on the host's localhost only (-p 127.0.0.1:{port}:{port}).",
      flush=True)
create_ui().queue().launch(server_name=os.environ.get("GRADIO_SERVER_NAME", "0.0.0.0"), server_port=port,
                           auth=(user, password), share=False, inbrowser=False)
sys.exit(0)
