/* gpu-bench TUI. Colours come from the gpu-bench theme in app.py. */

Screen { background: $background; color: $foreground; }

#header { dock: top; height: 3; padding: 0 1; border-bottom: solid $gb-border; }
#title { width: 1fr; height: 2; }
#job-state { width: auto; min-width: 34; height: 2; text-align: right; }

#body { height: 1fr; }
#sidebar { width: 28; height: 1fr; border-right: solid $gb-border; background: $surface; padding: 1 0 0 0; }
#nav { height: 1fr; border: none; background: $surface; padding: 0 1; scrollbar-size-vertical: 0; }
#nav:focus { border: none; background-tint: transparent; }

#content { width: 1fr; height: 1fr; }
Pane { height: 1fr; padding: 0 2 1 2; scrollbar-size-vertical: 1; }

.section-title { color: $secondary; text-style: bold; margin: 1 0 0 0; height: auto; }
.grow { width: 1fr; }
.card { background: $surface; border: round $gb-border; padding: 0 1; height: auto; margin: 1 0 0 0; }
.mono { text-wrap: nowrap; text-overflow: clip; }
.hint { color: $gb-muted; height: auto; }

.toolbar { height: auto; margin: 1 0 0 0; }
.toolbar Button { margin-right: 1; }
.form-row { height: auto; }
.field { width: 1fr; height: auto; margin: 0 1 0 0; }
.field-label { color: $gb-muted; margin: 1 0 0 0; }
Input { width: 1fr; }
Select { width: 1fr; }
SelectionList { height: auto; max-height: 9; border: round $gb-border; }
SelectionList:focus { border: round $primary; }

DataTable { height: auto; max-height: 24; margin: 1 0 0 0; }
Sparkline { height: 3; margin: 0 0 0 0; }
ProgressBar { margin: 1 0 0 0; }
.joblog { height: 12; border: round $gb-border; margin: 1 0 0 0; }
#logs-all { height: 1fr; border: round $gb-border; }

Confirm { align: center middle; background: $background 70%; }
#confirm { width: 60; height: auto; border: thick $warning; background: $surface; padding: 1 2; }
#confirm-text { height: auto; margin-bottom: 1; }
#confirm-buttons { height: auto; align-horizontal: right; }
#confirm-buttons Button { margin-left: 1; }
Sparkline.hidden-empty { display: none; }
