# LayerSmith configuration. Copy to .env and edit; every value is optional.
#
#   cp .env.example .env
#
# These are the defaults, shown so you can see what exists. The six paths
# below the data directory are also editable at runtime in Settings -> Storage;
# a value set here wins and is shown read-only there.

# ----------------------------------------------------------------- storage
# Everything LayerSmith keeps lives under one directory, so a container needs
# a single volume. A native install usually points this at /var/lib/layersmith.
LAYERSMITH_DATA_DIR=/data

# Exported OCI archives and air-gap bundles.
#LAYERSMITH_IMAGE_DIR=/data/images
# Build contexts, removed after each build.
#LAYERSMITH_BUILD_DIR=/data/builds
# Uploaded files and tool binaries, stored once per checksum.
#LAYERSMITH_UPLOAD_DIR=/data/uploads
# One log file per build.
#LAYERSMITH_LOG_DIR=/data/logs
# Scratch space used while bundling.
#LAYERSMITH_TMP_DIR=/data/tmp

# SQLite by default. Any SQLAlchemy URL works, for example PostgreSQL:
#   postgresql+psycopg://layersmith:CHANGE_ME@db.example.com/layersmith
#LAYERSMITH_DATABASE_URL=sqlite:////data/layersmith.db

# ----------------------------------------------------------- build backend
# auto (default) prefers Podman and falls back to Docker; or name one.
#LAYERSMITH_BUILD_BACKEND=auto
#LAYERSMITH_PODMAN_BINARY=podman
#LAYERSMITH_DOCKER_BINARY=docker
# Where the client should talk, when a socket is mounted into the container.
#DOCKER_HOST=unix:///var/run/docker.sock

# ----------------------------------------------------------------- defaults
# Architecture offered first in the wizard: amd64 or arm64.
#LAYERSMITH_DEFAULT_ARCH=amd64
# Namespace for image names, so a new project becomes layersmith/<name>.
#LAYERSMITH_DEFAULT_NAMESPACE=layersmith
# Largest accepted upload, in bytes (default 512 MiB).
#LAYERSMITH_MAX_UPLOAD_BYTES=536870912
# Most files and custom tools one image may reference (default 100).
#LAYERSMITH_MAX_FILES_PER_IMAGE=100
# Largest build context, in bytes (default 2 GiB). A build whose uploaded
# files exceed this fails instead of filling the data volume.
#LAYERSMITH_MAX_CONTEXT_BYTES=2147483648
# Keep build contexts after a build, for debugging. They can be large.
#LAYERSMITH_KEEP_BUILD_CONTEXTS=0

# ------------------------------------------------------------------ scanning
# Image scanning is optional and pluggable. Out of the box no scanner is
# configured: LayerSmith builds and exports images and says plainly that they
# are not scanned. Scanning reports; it never blocks a build.
#
# auto (default) uses a scanner when one is reachable, otherwise none.
#LAYERSMITH_SCANNER=auto
# Scan every image once it has been built.
#LAYERSMITH_SCAN_AFTER_BUILD=1
# What to look for: vulnerability, secret, misconfiguration. Only the kinds
# the configured scanner supports are actually requested.
#LAYERSMITH_SCAN_KINDS=vulnerability,secret
# Produce a CycloneDX SBOM alongside a scan, when the scanner can.
#LAYERSMITH_GENERATE_SBOM=1
# Seconds one scan may take before it is given up on.
#LAYERSMITH_SCANNER_TIMEOUT=600
#
# Any other LAYERSMITH_SCANNER_<KEY> variable is passed to the scanner as
# <key>, so a scanner's own options need no change to LayerSmith. For the
# Trivy backend, the ones worth knowing:
#
# The scanner image. Pinned; pull it to enable scanning.
#LAYERSMITH_SCANNER_IMAGE=ghcr.io/aquasecurity/trivy:0.74.0
# container (default) or binary, for a trivy installed on the host.
#LAYERSMITH_SCANNER_MODE=auto
# Which runtime starts the scan container; defaults to the build runtime.
#LAYERSMITH_SCANNER_RUNTIME=podman
# Where the vulnerability database is kept between scans.
#LAYERSMITH_SCANNER_CACHE_VOLUME=layersmith-trivy-db
# Running LayerSmith in a container: how the scanner reaches the archive.
# Name the volume holding the data directory (compose) ...
#LAYERSMITH_SCANNER_DATA_VOLUME=layersmith_layersmith-data
# ... or the host directory it is bind-mounted from.
#LAYERSMITH_SCANNER_HOST_DATA_DIR=/srv/layersmith
# Never download the database; use whatever has already been imported.
#LAYERSMITH_SCANNER_OFFLINE=0

# Scan reports and SBOMs.
#LAYERSMITH_SCAN_DIR=/data/scans
