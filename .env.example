# LayerSmith configuration. Copy to .env and edit; every value is optional.
#
#   cp .env.example .env
#
# These are the defaults, shown so you can see what exists. The five paths
# below the data directory are also editable at runtime in Settings -> Storage;
# a value set here wins and is shown read-only there.

# ----------------------------------------------------------------- storage
# Everything LayerSmith keeps lives under one directory, so a container needs
# a single volume. A native install usually points this at /var/lib/layersmith.
LAYERSMITH_DATA_DIR=/data

# Exported OCI archives and air-gap bundles.
#LAYERSMITH_IMAGE_DIR=/data/images
# Build contexts, removed after each build.
#LAYERSMITH_BUILD_DIR=/data/builds
# Uploaded files and tool binaries, stored once per checksum.
#LAYERSMITH_UPLOAD_DIR=/data/uploads
# One log file per build.
#LAYERSMITH_LOG_DIR=/data/logs
# Scratch space used while bundling.
#LAYERSMITH_TMP_DIR=/data/tmp

# SQLite by default. Any SQLAlchemy URL works, for example PostgreSQL:
#   postgresql+psycopg://layersmith:CHANGE_ME@db.example.com/layersmith
#LAYERSMITH_DATABASE_URL=sqlite:////data/layersmith.db

# ----------------------------------------------------------- build backend
# auto (default) prefers Podman and falls back to Docker; or name one.
#LAYERSMITH_BUILD_BACKEND=auto
#LAYERSMITH_PODMAN_BINARY=podman
#LAYERSMITH_DOCKER_BINARY=docker
# Where the client should talk, when a socket is mounted into the container.
#DOCKER_HOST=unix:///var/run/docker.sock

# ----------------------------------------------------------------- defaults
# Architecture offered first in the wizard: amd64 or arm64.
#LAYERSMITH_DEFAULT_ARCH=amd64
# Namespace for image names, so a new project becomes layersmith/<name>.
#LAYERSMITH_DEFAULT_NAMESPACE=layersmith
# Largest accepted upload, in bytes (default 512 MiB).
#LAYERSMITH_MAX_UPLOAD_BYTES=536870912
# Keep build contexts after a build, for debugging. They can be large.
#LAYERSMITH_KEEP_BUILD_CONTEXTS=0
